# Обов'язково
ANTHROPIC_API_KEY=sk-ant-...
SERPER_API_KEY=...
APP_PASSWORD=змініть-мене          # пароль входу в інтерфейс
SECRET_KEY=довгий-випадковий-рядок # підпис сесійних cookie

# Необов'язково
ANTHROPIC_MODEL=claude-sonnet-4-5  # модель Claude
DATA_DIR=/data                     # папка для БД і файлів (на Railway — Volume)
MAX_COMPETITORS=6                  # скільки сторінок ТОПу парсити на запит
PARALLEL_CLUSTERS=2                # скільки кластерів обробляти одночасно
MOCK=0                             # 1 = без зовнішніх API (для перевірки інтерфейсу)

# Збір семантики: частотність Google Ads (Keyword Planner) через DataForSEO
DATAFORSEO_LOGIN=...
DATAFORSEO_PASSWORD=...
